<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Local ad-hoc builds only (`pnpm dist:adhoc`). An ad-hoc signature has no Team ID, so library validation would refuse
  the sidecar's native addons; these builds turn it off. Release builds use entitlements.mac.plist instead.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
